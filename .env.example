# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LIFEHUB_PBKDF2_ITERATIONS: Number of PBKDF2-HMAC-SHA512 iterations for password hashing.
# Default and minimum enforced floor: 220000 (compliant with OWASP 2026 guidelines).
# Higher values (e.g., 300000) can be configured for more powerful servers.
# Values below 220000 are ignored and automatically replaced with the 220000 minimum floor.
LIFEHUB_PBKDF2_ITERATIONS=220000

# PostgreSQL Persistence Layer Configuration (Single Source of Truth)
# Configures the connection to PostgreSQL via Drizzle ORM
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_USER="lifehub"
SQL_PASSWORD="lifehub_secret_pass"
SQL_DB_NAME="lifehub_primary"
SQL_SSL="false"

# Optional direct database connection string (takes precedence if provided)
DATABASE_URL="postgres://lifehub:lifehub_secret_pass@127.0.0.1:5432/lifehub_primary"

# Persistence driver: 'memory' (default transition driver) or 'postgres'
PERSISTENCE_DRIVER="memory"
